# 生产机（OpenClaw 宿主机）上的凭证。不要提交真实值，也不要写进 Skill。
# 二选一：直接给环境变量，或给一个只存在于宿主机的文件路径。

# 夸克。浏览器登录 pan.quark.cn 后，从 drive.quark.cn 请求头复制整段 Cookie。
QUARK_COOKIE=
# QUARK_COOKIE_FILE=/run/secrets/quark_cookie

# 百度开放平台 OAuth access_token。应用需要开通「文件分享」转存和创建分享权限。
BAIDU_NETDISK_ACCESS_TOKEN=
# BAIDU_NETDISK_ACCESS_TOKEN_FILE=/run/secrets/baidu_token

# 目录规则。不设置时使用当前目录的 directory_rules.json；没有该文件则全部进「待分类」。
# NETDISK_RULES_PATH=/opt/openclaw/directory_rules.json

# 可选覆盖。一般留空，规则文件里已经有根目录。
# NETDISK_QUARK_ROOT=/闲鱼资源
# NETDISK_BAIDU_ROOT=/闲鱼资源
# NETDISK_FALLBACK_FOLDER=待分类

# 百度创建分享的提取码。留空表示公开分享；若开放平台拒绝空提取码，再设 4 位字符。
# 不要依赖任何默认值，参考实现里的 1234 / 7 天在这里被明确禁止。
# NETDISK_BAIDU_SHARE_PWD=

# 两次会改变网盘的操作之间的最短间隔秒数。
NETDISK_MIN_INTERVAL_SECONDS=3
